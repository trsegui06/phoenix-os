# Local development only. Hosted environments must use their own HTTPS Supabase project origin.
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key. Never commit a secret or service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact trusted application origin. Production requires a non-local HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
